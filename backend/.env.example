# این فایل را کپی کنید به .env و مقادیر واقعی را وارد کنید
# .env را هرگز به گیت/گیت‌هاب پوش نکنید

# باید شامل schema باشد (http:// یا https://)
ROUTER_HOST=http://192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=رمز_واقعی_مودم

# آدرس‌(های) فرانت‌اندی که اجازه دارند به این بک‌اند درخواست بزنند (با کاما جدا کنید)
ALLOWED_ORIGINS=http://localhost:5173

FLASK_DEBUG=false
PORT=5000
